{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus-brain.local/schema/cell-signature-1.0.json",
  "title": "Nexus Brain Cell Signature",
  "description": "Research contract for one multimodal cellular observation.",
  "type": "object",
  "required": ["schemaVersion", "observationId", "modalities", "provenance"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "observationId": { "type": "string", "minLength": 1 },
    "modalities": {
      "type": "object",
      "properties": {
        "morphology": { "type": "object" },
        "surfaceMarkers": { "type": "object" },
        "proteomics": { "type": "object" },
        "transcriptomics": { "type": "object" },
        "genomics": { "type": "object" },
        "metabolism": { "type": "object" },
        "physicalProperties": { "type": "object" },
        "temporal": { "type": "object" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["sourceType"],
      "properties": {
        "sourceType": { "type": "string" },
        "instrument": { "type": ["string", "null"] },
        "datasetVersion": { "type": ["string", "null"] },
        "timestamp": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}